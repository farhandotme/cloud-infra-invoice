# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/cloudledger

# Use a long, random secret (32+ characters). Do not commit real secrets.
JWT_SECRET=

# Initial administrator is created automatically only when these are provided
ADMIN_NAME=Workspace Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# IMPORTANT: set this to the client code for the customer portal deployment.
# Admin still manages all clients; the customer portal only returns this client's records plus records without a clientCode (shared/global records).
PUBLIC_CLIENT_CODE=

# Optional: frontend API base when frontend and backend are hosted separately
# VITE_API_URL=https://api.yourdomain.com
